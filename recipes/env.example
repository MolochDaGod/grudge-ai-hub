# Grudge fleet — copy to .env.local. Never commit secrets.
# Identity is Grudge ID JWT. Puter is user-pays FS + host, not product login.

# --- public fleet (safe to bake into client) ---
VITE_ID_URL=https://id.grudge-studio.com
VITE_AI_URL=https://ai.grudge-studio.com
VITE_ASSETS_URL=https://assets.grudge-studio.com
VITE_OBJECTSTORE_URL=https://objectstore.grudge-studio.com/api/v1
VITE_FORGE_URL=https://forge.grudge-studio.com
VITE_CODER_URL=https://coder.grudge-studio.com
VITE_PUTER_TOOLKIT=https://puter.grudge-studio.com
VITE_PUTER_SPACE=https://ai.grudge-studio.com/puter-space
VITE_INFO_DOCS=https://info.grudge-studio.com/docs
VITE_CODEX=https://info.grudge-studio.com/docs/CANONICAL_CODEX.md

# --- optional local / BYOK (wrangler secret put on workers; never git) ---
# GEMINI_API_KEY=
# GROQ_API_KEY=
# XAI_API_KEY=
# GRUDGE_JWT=

# --- recipe pin ---
GRUDGE_RECIPE=grudge-play
GRUDGE_THREE=0.185.0
GRUDGE_RAPIER=0.19.0
